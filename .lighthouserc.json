{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      },
      "startServerCommand": "node scripts/lighthouse-server.mjs",
      "startServerReadyPattern": "lighthouse fixture server ready",
      "startServerReadyTimeout": 20000,
      "url": [
        "http://127.0.0.1:8791/index.html",
        "http://127.0.0.1:8791/404.html",
        "http://127.0.0.1:8791/activity/index.html",
        "http://127.0.0.1:8791/admin/index.html",
        "http://127.0.0.1:8791/cart/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "resource-summary:total:size": [
          "warn",
          {
            "maxNumericValue": 4000000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
