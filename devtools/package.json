{
  "name": "nimshop-devtools",
  "private": true,
  "version": "2.0.0",
  "description": "Devtools launcher for nimiqshop.io — builds the Go backend and Astro frontend automatically, then starts the full stack (with optional Cloudflare Quick Tunnel).",
  "type": "module",
  "scripts": {
    "start": "node devtools.mjs tunnel",
    "dev": "node devtools.mjs dev",
    "preview": "node devtools.mjs preview",
    "tunnel": "node devtools.mjs tunnel",
    "build": "node devtools.mjs build",
    "rebuild": "node devtools.mjs rebuild",
    "install:cloudflared": "node ensure-cloudflared.mjs",
    "cloudflared:version": "node ensure-cloudflared.mjs",
    "stop": "node -e \"require('node:child_process').execSync(process.platform==='win32'?'devtools/stop.bat':'bash devtools/stop.sh',{stdio:'inherit'})\""
  }
}
