# Frontend is fully static — no build step. This file is for reference only.
# The real runtime config is frontend/config.js — edit that file before deploying.
#
# For documentation of separate domains setup, see frontend/README.md and frontend/config.js

# Example for SAME-ORIGIN (nginx):
# API_BASE=/api
# FRONTEND_URL=https://nim.shop

# Example for SEPARATE DOMAINS:
# API_BASE=https://api.nim.shop/api
# FRONTEND_URL=https://nim.shop

# Nimiq Hub
# HUB_URL=https://hub.nimiq.com
# NETWORK=mainnet
