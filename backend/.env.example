# --- Shop identity (ONE env for every user-facing site name) ---
# Hostname only, no scheme. Drives Hub login messages, gift emails,
# cashback memos, user-agent, /api/site (frontend brand/footer/title).
SITE_HOST=shop.nimiqbase.com

# --- CHECKOUT OPTIONS IN THIS TEMPLATE ---
# USDT payment is ALWAYS ON — there is no env switch for it. BTC Lightning
# (Nimiq Pay) stays the default rail; USDT on Polygon (Matic) is the built-in
# second method (network fixed in code, nothing to configure).
#
#   "Plant trees" cashback donation -> TREE_PLANTING_ENABLED=true + NIM address set
#       (config refuses to start if trees are enabled but the NIM address is empty)
#
# routes to the buyer's wallet by default, or to the tree-planting NIM address when
# the buyer picks "Plant trees" at checkout.

# --- HTTP ---
LISTEN_ADDR=:8084
# Built frontend folder (Astro dist/). Empty = API only.
# Release installer sets this to "frontend".
STATIC_DIR=

# --- BadgerDB (embedded key/value database) ---
# Every commit fsyncs (SyncWrites=true). A power cut cannot drop the last
# quote WAL / cashback hex / payment attach.
# A live quote (order_creating → delivering) for the same cart is a lock:
# CreateQuote returns that row and never calls CreateOrder again. There is
# no 60-second window. An ambiguous CreateOrder (timeout/5xx/429) leaves
# the quote in order_creating with the supplier-request marker; the tracker
# will not re-POST.
BADGER_DIR=./data/badger
#
# Memory envelope (optional, for high-traffic deployments). Defaults fit a
# 2-4 GB VPS. On an 8-16 GB box serving six-figure concurrent visitors raise:
#   BADGER_MEMTABLE_MB=128        (write buffer; default 64)
#   BADGER_NUM_MEMTABLES=6        (default 5)
#   BADGER_BLOCK_CACHE_MB=512     (read cache; default 256)
#   BADGER_INDEX_CACHE_MB=128
#   BADGER_NUM_COMPACTORS=6       (default 4)
# And give the Go runtime a soft heap ceiling so GC stays predictable:
#   GOMEMLIMIT=6GiB   (process env, not read from this file)

# --- Auth ---
JWT_SECRET=REPLACE_WITH_A_32_BYTE_RANDOM_SECRET
JWT_EXPIRY_MINS=10080

# --- CORS / Frontend Origin ---
# Frontend is fully static (no build). Backend and frontend can be on separate domains.
#
# SAME-ORIGIN (nginx): frontend and backend on same domain (e.g. https://shop.nimiqbase.com)
#   nginx: / -> static frontend, /api -> proxy to backend
#   ALLOWED_ORIGINS can be empty or same origin — no CORS needed
#   Frontend config.js: API_BASE='/api'
#
# SEPARATE DOMAINS (production, e.g. Cloudflare Pages + separate API):
#   Frontend: https://shop.nimiqbase.com (static)
#   Backend:  https://shopapi.nimiqbase.com (Go)
#   Frontend config.js: API_BASE='https://shopapi.nimiqbase.com/api'
#   Backend: ALLOWED_ORIGINS=https://shop.nimiqbase.com,https://www.shop.nimiqbase.com
#   Also update frontend/_headers and frontend/*.html CSP connect-src to include https://shopapi.nimiqbase.com
#
# The backend now handles OPTIONS preflight properly (204 + CORS headers).
# Credentials (Authorization header) are allowed — browser will send JWT.
#
# For local dev with live-proxy (same-origin to browser): keep API_BASE='/api', no CORS needed
# For local dev with direct separate domains:
#   Frontend config.js: API_BASE='http://localhost:8080/api'
#   Backend: ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8000
#
# Wildcard subdomain support: https://*.example.com is supported in code (checks suffix)
# Example: ALLOWED_ORIGINS=https://*.shop.nimiqbase.com,https://shop.nimiqbase.com
# --- FRONTEND_URL: ONE line that fixes all CORS ---
# Set this to where the browser loads the shop from. It feeds the whole CORS
# allowlist whenever ALLOWED_ORIGINS (below) is empty. Examples:
#   http://localhost:8085                      (local static server)
#   https://shop.example.com                   (your domain / Cloudflare Pages)
FRONTEND_URL=https://shop.nimiqbase.com
# Explicit comma list wins over FRONTEND_URL. Empty = derived from FRONTEND_URL.
# GitHub Pages (https://emrealt34.github.io) is always appended in code.
ALLOWED_ORIGINS=

# --- PUBLIC_API_URL: ONE line that drives the frontend build ---
# The public URL where browsers reach THIS backend (no trailing slash). The
# frontend build (`npm run build` / `npm run build:all`) reads it automatically
# and bakes it into every page: API_BASE, CSP connect-src and the preconnect.
#   Backend  https://shopapi.example.com  →  PUBLIC_API_URL=https://shopapi.example.com
PUBLIC_API_URL=https://shopapi.nimiqbase.com

# --- Cross-domain cookie mode ---
# When the frontend (shop.example.com) and this API (api.example.com) are on
# DIFFERENT sites, browser cookies must be SameSite=None + Secure or logins
# silently fail (the browser never sends the cookie back on cross-site calls).
# Same-origin deployments can remove these three lines (defaults: lax/true).
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true
ADMIN_COOKIE_SECURE=true

MAX_REQUEST_BODY_BYTES=1048576
MAX_ORDER_QUANTITY=10

# --- Per-user daily purchase limits ---
# Purchase budgets: daily = rolling 24 hours; monthly = UTC calendar month.
# These purchase ceilings are separate from the staking cashback cap.
# A value of 0 disables that ceiling. Supplier limits still apply.
DAILY_ORDER_LIMIT=9
DAILY_SPEND_LIMIT_USD=250
MONTHLY_SPEND_LIMIT_USD=500

# --- Informational NIM/USD estimate (market price feed) ---
# Shown as an estimate only. The authoritative payment amount is the coin
# amount quoted by the supplier (CryptoRefills).
PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price?ids=nimiq-2&vs_currencies=usd
# At least TWO independent price feeds are used for the estimate; a wider
# spread than this (bps) makes the estimate unavailable rather than stale.
ORACLE_MIN_SOURCES=2
ORACLE_MAX_SPREAD_BPS=250

# --- CryptoRefills Business API ---
# CryptoRefills is the merchant of record. Every request authenticates with
# the partner id (X-Cr-Application) and app version (X-Cr-Version) headers.
CRYPTOREFILLS_BASE_URL=https://api.cryptorefills.com
CRYPTOREFILLS_PARTNER_ID=YQyw0dJ0FM
CRYPTOREFILLS_APP_VERSION=nimshop/1.0
# End-customer calls forward their actual User-Agent and trusted IP. This is
# only the fallback for historical records with no saved browser attribution.
CRYPTOREFILLS_USER_AGENT=nimshop/1.0 +https://shop.nimiqbase.com
# Optional account-managed webhook trigger (not specified by the public API guide).
# Register it with Cryptorefills before enabling it; a verified API GET remains authority.
CRYPTOREFILLS_WEBHOOK_KEY=
# Public HTTPS backend base URL, no trailing slash. Required when
# CRYPTOREFILLS_WEBHOOK_KEY is set and the partner account has callbacks enabled.
# Polling is the primary supported fallback and works WITHOUT webhooks.
# For separate domains: https://shopapi.nimiqbase.com
PUBLIC_WEBHOOK_BASE_URL=

# --- Supplier order tracker (crash recovery) ---
# WORKER_ORDER_POLL_SECS (2-60) is the tracker's TICK granularity, NOT a
# per-order poll rate: each open order gets its own adaptive schedule
# (awaiting/started/received 10s, delivering 8s, manual reconciliation 60s), at most 8
# supplier polls per tick, per-quote exponential backoff (30s -> 30min,
# jittered) after transient errors, a global circuit breaker when failures
# cluster, and whole-pass skips while the supplier endpoint is cooling
# down. Shared partner-account traffic can still hit upstream limits. Run ONE
# backend per durable database and coordinate any other partner integrations.
# WORKER_ORDER_STALE_SECS (25-3600) is the order-creation stale bound,
# measured from the durable supplier-request marker: a quote still in
# order_creating without a supplier order id after this window is parked
# in manual_review instead of being auto re-sent (duplicate-order guard).
# It must exceed the 20s supplier call timeout.
WORKER_ORDER_POLL_SECS=5
WORKER_ORDER_STALE_SECS=300

# --- Customer API rate limit (per IP, token bucket) ---
# 20x the previous 180/60 local defaults. These are NOT supplier quotas.
# Existing deployment environment values override these defaults.
RATE_LIMIT_PER_MINUTE=3600
RATE_LIMIT_BURST=1200

# --- Global CryptoRefills account queue ---
# Every CryptoRefills call (catalog, order creation, webhook verification and
# crash adoption) goes through one fair round-robin dispatcher. Per-actor
# budgets prevent one user/IP from monopolising the shared CryptoRefills
# partner account. Known endpoint local budgets are also 20x higher; supplier
# lower-limit/remaining headers and 429 Retry-After always take precedence.
# The developer docs do not publish numeric endpoint quotas. Run one supplier
# dispatcher per partner key; multiple replicas need a shared limiter.
# The queue is bounded to prevent memory abuse; admissions
# that would wait longer than ~5s for a budget slot fail fast with
# 429 + Retry-After.
CRYPTOREFILLS_QUEUE_MAX=2000
CRYPTOREFILLS_QUEUE_PER_ACTOR_MAX=100
CRYPTOREFILLS_ACTOR_REQUESTS_PER_MINUTE=600
CRYPTOREFILLS_ACTOR_BURST=120

# --- Local development only ---
# true = allow plain HTTP for loopback mock endpoints (127.0.0.1 only).
# Production: false.
ALLOW_HTTP_LOCAL=false

# --- Admin login ---
# Full admin accounts (bootstrap endpoint or the legacy ADMIN_PASSWORD_HASH +
# ADMIN_TOTP_SECRET seed) use RFC 6238 TOTP with HMAC-SHA-256, six digits,
# 30-second steps. Enroll the authenticator from the otpauth:// URI the
# bootstrap response returns (or set algorithm = SHA256 by hand); an entry
# typed in with the app's SHA-1 default will not produce matching codes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_SESSION_MINS=480
# ADMIN_COOKIE_SECURE lives in the cross-domain cookie block above.
# Persistent admin session secret (openssl rand -hex 32): without it a new one
# is generated on every boot and admin logins do not survive restarts.
ADMIN_SESSION_SECRET=

# --- Client IP / geo resolution ---
# TRUST_PROXY alone is not blanket trust in forwarding headers. Immediate peer
# allowlists and (for the recommended Node hop) the private shared secret apply.
# Geo, rate limiting, audit and supplier calls reuse the same resolved identity.
# Forwarding headers are accepted ONLY from these immediate TCP peers.
# For Cloudflare Tunnel these are local connector/proxy IPs, NOT the public
# Cloudflare address ranges. Never use 0.0.0.0/0 or ::/0.
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Recommended: cloudflared -> Node origin -> Go. The shared launcher sets the
# private secret in BOTH processes automatically (and never prints it).
PROXY_HEADER_MODE=forwarded
FORWARDED_HEADER_SECRET=
# If cloudflared connects DIRECTLY to this Go API (no Node hop), use
# PROXY_HEADER_MODE=cloudflare, an empty shared secret, and a network-restricted
# origin. Missing/invalid CF IP headers then stop the request instead of using
# the connector IP as the customer. See CLOUDFLARE-TUNNEL.md.


# --- TEST MODE sandbox (simulated payments) --- ON by default (TEST_MODE=true):
# the whole shop runs NORMALLY — wallet logins, real catalog, real checkout
# validation and pricing, real Mailtrap emails, the real cashback engine and
# tree contributions — but every PAYMENT is simulated: quotes attach
# simulated invoices (no supplier order is ever created), the pay screen
# shows a "Pay now — simulated" button (both at checkout and on the order
# page), and cashback payouts / wallet memos run through the same pipeline
# without ever signing or broadcasting a transaction (TESTTX-… hashes).
# The frontend flag (public/config.js TEST_MODE: true) matches this default,
# so customers see the banner and the simulated pay button out of the box.
# Go live by setting BOTH to false: TEST_MODE=false here and TEST_MODE: false
# in public/config.js.
TEST_MODE=true

# --- Mailtrap email (the ONLY mail transport; there is no SMTP client and no SMS sender) ---
MAILTRAP_API_TOKEN=REPLACE_WITH_MAILTRAP_API_TOKEN
# Sender defaults to hello@shop.nimiqbase.com. Optional: MAILTRAP_FROM_NAME,
# MAILTRAP_REPLY_TO, MAILTRAP_CATEGORY, MAILTRAP_TIMEOUT, and for staging
# MAILTRAP_USE_SANDBOX=true + MAILTRAP_SANDBOX_ID (captured, never delivered).

# --- Shop-wallet cashback (operator NIM → buyer) ---
# Paid ONLY after CryptoRefills marks the order fulfilled. Amount is
# cashback_bps (admin console, default 0 = 0%) of the product's NIM
# price, locked at fulfill time. Memo: "You earn X NIM by purchasing Y from shop.nimiqbase.com"
# The payout wallet: paste EITHER a 32-byte hex Ed25519 seed OR your wallet's
# 24-word recovery phrase directly (one line). A phrase is derived exactly the
# way the Nimiq Hub / Nimiq Safe do it (BIP39 → m/44'/242'/0'); the startup
# banner prints the derived address + balance — VERIFY it matches your wallet
# before enabling payouts. Leave CASHBACK_ENABLED=false until you have
# validated a send with: go run ./cmd/notif-test ... (-key takes the phrase
# too). Tool: go run ./cmd/keyinfo_main.go '<phrase>' prints seed/address.
# SINGLE RPC by default (NimiqWatch). The wire format + pushTransaction are
# validated live on both networks (see README_SETUP.md section 8). Set
# NIMIQ_RPC_URL_2 only if you want a second, cross-checking provider
# (reads must then agree before cashback is marked paid).
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
NIMIQ_RPC_URL_2=
CASHBACK_ENABLED=false
CASHBACK_WALLET_SEED=
# Which Hub account a recovery phrase pays from (m/44'/242'/<account>').
# 0 = the first account the Nimiq Hub shows. Only relevant when
# CASHBACK_WALLET_SEED is a recovery phrase.
CASHBACK_WALLET_ACCOUNT=0
# mainnet = network id 24, testnet = network id 5 (Albatross).
# testnet RPC: https://rpc.testnet.nimiqwatch.com  faucet: https://faucet.pos.nimiq-testnet.com/tapit
CASHBACK_NETWORK=mainnet
CASHBACK_FEE_LUNA=1
# Optional legacy promo-code cashback table. The code's rate is EXCLUSIVE: when a
# buyer enters one of these codes, it replaces the normal base/staker cashback
# for that order. The admin page can take ownership of promo rules; until then,
# this env value is used as the fallback source. Format: CODE:1000,CODE2:750
# (basis points) or JSON. Example: CASHBACK_CODES=NIM10:1000,VIP7:700
CASHBACK_CODES=

# --- Pool-staker cashback (stake in YOUR pool → cashback unlock) ---
# Buyers who delegate NIM to your own validator earn the staker rate you set
# in the admin console instead of the base rate. The simplest setup is base 0%
# plus a single 0-minimum rung at 1%, which means any verified positive stake
# earns 1%. The stake is re-checked at FULFILLMENT time, so an unstake before
# delivery earns the base rate.
#
# POOL_API_URL: base URL of your GoPool install. Its GET /api/stakers/{address}
#   is public (200 = delegated, 404 = not). Called server-to-server — the pool
#   sends no CORS headers, so this must never be called from the browser.
#   Empty = the whole feature is off and every buyer gets the base rate.
# POOL_VALIDATOR_ADDRESS: the validator the in-app "Stake with us" button
#   delegates to (Nimiq Pay sendNewStakerTransaction). Empty = no in-app CTA,
#   the shop only verifies and displays.
# A pool outage never blocks delivery and never grants a boost: the buyer
# falls back to the base rate and the UI says the check was unavailable.
POOL_API_URL=
POOL_VALIDATOR_ADDRESS=
# POOL_FEED_API_KEY: shared secret that unlocks the pool's authenticated
#   GET /api/cashback/profit endpoint (sent as the X-Feed-Key header). It MUST
#   match GPOOL_FEED_API_KEY on the pool side byte-for-byte. Empty = the staker
#   "cashback katlanma" profit boost never accrues (base rate still works).
#   Generate one with: openssl rand -hex 32
POOL_FEED_API_KEY=
# How often (seconds) the on-demand profit refresher may re-ask the pool.
POOL_FEED_POLL_SECONDS=30
POOL_STAKE_TIMEOUT_SECONDS=0   # 0 = 3s per lookup
POOL_STAKE_CACHE_TTL_SECONDS=0 # 0 = 60s; the answer is cached per address

# --- USDT (Polygon) payment rail — always on, no enable/network env ---
# CryptoRefills supports USDT on Polygon (contract 0xc2132D05D31c914a87C6611C10748AEb04B58e8F,
# 6 decimals). The frontend ALWAYS shows the payment-method picker
# (Nimiq Pay / USDT Polygon) and the network is fixed to Polygon (Matic) in
# code. Inside Nimiq Pay the buyer pays in ONE tap through the injected EVM
# provider (window.ethereum: eth_requestAccounts → wallet_switchEthereumChain
# 0x89 → ERC-20 transfer). USDT payers DO earn cashback but at
# USDT_CASHBACK_MULTIPLIER of the NIM rate (default 0.5 = 50%). Set to 1 for
# parity or 0 to disable cashback for the stablecoin rail.
USDT_COIN=USDT
USDT_CASHBACK_MULTIPLIER=0.5

# --- Tree planting (cashback → donation) ---
# When enabled, logged-in buyers can choose to send their cashback to the
# TREE_PLANTING_NIM_ADDRESS (a Nimiq wallet you control) instead of their own
# wallet. /plant-trees shows the collected balance, tree count, leaderboard and
# PolygonScan links so everything is provably public.
TREE_PLANTING_ENABLED=true
# PUBLIC receiving address only. When checkout selects tree planting, the
# cashback ledger routes the contribution to this address.
# NEVER put a mnemonic or private key in this file or on the server.
TREE_PLANTING_NIM_ADDRESS=NQ11 AS8P RVKB 91S3 F92Y T6J7 K6HH LS0C PLH0
# No TREE_PLANTING_PRIVATE_KEY / TREE_PLANTING_MNEMONIC setting exists by design.
# Tree payouts must be signed offline by the wallet owner.
TREES_PER_USD=1                    # OneTreePlanted: ~$1 = 1 tree
# NOTE: there is NO tree-USDT env address to fill. The monthly payout is done by
# you manually (off-site): swap the collected cashback NIM to USDT, send it to
# OneTreePlanted on Polygon, then disclose it in the ADMIN PANEL ("Record tree
# settlement": month + amount USDT + Polygon tx hash + from/to addresses + note).
# The admin panel stores it and /plant-trees shows it with a PolygonScan link —
# nothing here needs pre-configuring.
