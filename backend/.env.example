# --- HTTP ---
LISTEN_ADDR=:8080

# --- BadgerDB (embedded key/value database) ---
BADGER_DIR=./data/badger

# --- Auth ---
JWT_SECRET=REPLACE_WITH_A_32_BYTE_RANDOM_SECRET
JWT_EXPIRY_MINS=10080

# --- CORS / Frontend Origin ---
# Frontend is fully static (no build). Backend and frontend can be on separate domains.
#
# SAME-ORIGIN (nginx): frontend and backend on same domain (e.g. https://nim.shop)
#   nginx: / -> static frontend, /api -> proxy to backend
#   ALLOWED_ORIGINS can be empty or same origin — no CORS needed
#   Frontend config.js: API_BASE='/api'
#
# SEPARATE DOMAINS (production, e.g. Cloudflare Pages + separate API):
#   Frontend: https://nim.shop (static)
#   Backend:  https://api.nim.shop (Go)
#   Frontend config.js: API_BASE='https://api.nim.shop/api'
#   Backend: ALLOWED_ORIGINS=https://nim.shop,https://www.nim.shop
#   Also update frontend/_headers and frontend/*.html CSP connect-src to include https://api.nim.shop
#
# The backend now handles OPTIONS preflight properly (204 + CORS headers).
# Credentials (Authorization header) are allowed — browser will send JWT.
#
# For local dev with live-proxy (same-origin to browser): keep API_BASE='/api', no CORS needed
# For local dev with direct separate domains:
#   Frontend config.js: API_BASE='http://localhost:8080/api'
#   Backend: ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8000
#
# Wildcard subdomain support: https://*.example.com is supported in code (checks suffix)
# Example: ALLOWED_ORIGINS=https://*.nim.shop,https://nim.shop
ALLOWED_ORIGINS=https://nim.shop,https://www.nim.shop,https://*.trycloudflare.com,http://localhost:4321,http://localhost:8000

MAX_REQUEST_BODY_BYTES=1048576
MAX_ORDER_QUANTITY=10

# --- Per-user daily purchase limits ---
DAILY_ORDER_LIMIT=3
DAILY_SPEND_LIMIT_USD=50

# --- Informational NIM/USD estimate (market price feed) ---
# Shown as an estimate only. The authoritative payment amount is the coin
# amount quoted by the supplier (CryptoRefills).
PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price?ids=nimiq-2&vs_currencies=usd
# At least TWO independent price feeds are used for the estimate; a wider
# spread than this (bps) makes the estimate unavailable rather than stale.
ORACLE_MIN_SOURCES=2
ORACLE_MAX_SPREAD_BPS=250

# --- CryptoRefills Business API ---
# CryptoRefills is the merchant of record. Every request authenticates with
# the partner id (X-Cr-Application) and app version (X-Cr-Version) headers.
CRYPTOREFILLS_BASE_URL=https://api.cryptorefills.com
CRYPTOREFILLS_PARTNER_ID=REPLACE_WITH_YOUR_PARTNER_ID
CRYPTOREFILLS_APP_VERSION=nimshop/1.0
CRYPTOREFILLS_USER_AGENT=nimshop/1.0 +https://nim.shop
# CryptoRefills' webhook payload isn't HMAC-signed. Generate a separate random
# secret; it is appended to the callback URL and checked in constant time.
CRYPTOREFILLS_WEBHOOK_KEY=REPLACE_WITH_A_SEPARATE_32_BYTE_RANDOM_SECRET
# Public HTTPS backend base URL, no trailing slash. Required when
# CRYPTOREFILLS_WEBHOOK_KEY is set: fulfillment is webhook-only; there is no
# supplier-status polling fallback for live orders.
# For separate domains: https://api.nim.shop
PUBLIC_WEBHOOK_BASE_URL=https://api.nim.shop

# --- Supplier order tracker (crash recovery) ---
# WORKER_ORDER_POLL_SECS (2-60) is the tracker's TICK granularity, NOT a
# per-order poll rate: each open order gets its own adaptive schedule
# (awaiting_payment 15s -> 120s by age, paid/delivering 8-10s), at most 8
# supplier polls per tick, per-quote exponential backoff (30s -> 30min,
# jittered) after transient errors, a global circuit breaker when failures
# cluster, and whole-pass skips while the supplier endpoint is cooling
# down. The supplier rate limit is therefore unreachable by configuration
# alone — do not raise other limits to "fix" polling.
# WORKER_ORDER_STALE_SECS (25-3600) is the order-creation stale bound,
# measured from the durable supplier-request marker: a quote still in
# order_creating without a supplier order id after this window is parked
# in manual_review instead of being auto re-sent (duplicate-order guard).
# It must exceed the 20s supplier call timeout.
WORKER_ORDER_POLL_SECS=5
WORKER_ORDER_STALE_SECS=300

# --- Customer API rate limit (per IP, token bucket) ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# --- Global CryptoRefills account queue ---
# Every CryptoRefills call (catalog, order creation, webhook verification and
# crash adoption) goes through one fair round-robin dispatcher. Per-actor
# budgets prevent one user/IP from monopolising the shared CryptoRefills
# partner account. The queue is bounded to prevent memory abuse; admissions
# that would wait longer than ~5s for a budget slot fail fast with
# 429 + Retry-After.
CRYPTOREFILLS_QUEUE_MAX=2000
CRYPTOREFILLS_QUEUE_PER_ACTOR_MAX=100
CRYPTOREFILLS_ACTOR_REQUESTS_PER_MINUTE=30
CRYPTOREFILLS_ACTOR_BURST=6

# --- Local development only ---
# true = allow plain HTTP for loopback mock endpoints (127.0.0.1 only).
# Production: false.
ALLOW_HTTP_LOCAL=false

# --- Admin (separate from customer JWT authentication) ---
# Admin console is DISABLED by default (all three empty). To enable: set
# ADMIN_USERNAME (3-64 chars), a pre-generated Argon2id PHC in
# ADMIN_PASSWORD_HASH, and a base32 ADMIN_TOTP_SECRET together with a separate
# 32+ byte ADMIN_SESSION_SECRET. Leaving them blank starts with no admin.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MINS=480
ADMIN_COOKIE_SECURE=true
# TEST-ONLY shortcut: when ADMIN_DEV_USERNAME/ADMIN_DEV_PASSWORD are set,
# that username+password logs into /admin.html WITHOUT TOTP (constant-time
# compare, audited as "dev env credentials"). Use for local dev/smoke tests.
# Requires ADMIN_SESSION_SECRET (32+ bytes). NEVER set in production.
ADMIN_DEV_USERNAME=
ADMIN_DEV_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=

# --- Client IP / geo resolution ---
# When the backend sits behind Cloudflare or a reverse proxy (recommended),
# set true so it trusts CF-Connecting-IP + CF-IPCountry and X-Forwarded-For to
# find the real client IP (used for rate limiting, admin audit and /api/geo).
# Keep this ON with a Cloudflare-proxied origin; set false only if the origin
# is directly exposed and you do NOT want to trust forwarded headers.
# The frontend never calls an external geo API (no ipapi etc.); /api/geo on this
# backend is the only IP/country source.
TRUST_PROXY=true


# Development only: enables the free test-buy route.
TEST_MODE=false

# --- Gift notification channel (email + SMS) ---
# Both are OFF by default; opt in by setting *_ENABLED=true and supplying
# the provider credentials. Failures are logged but never block order flow.

# --- Email (generic SMTP — Gmail / SendGrid / Mailgun / etc.) ---
NOTIFY_EMAIL_ENABLED=false
# Gmail example: NOTIFY_SMTP_HOST=smtp.gmail.com, NOTIFY_SMTP_PORT=587,
#  use an "App Password" (not your account password) when 2FA is on.
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM_NAME=nim.shop gifts
NOTIFY_SMTP_FROM_ADDR=
NOTIFY_EMAIL_SUBJECT=🎁 A gift for you from nim.shop
NOTIFY_EMAIL_DRY_RUN=false  # true = log only, false = real send

# --- SMS (generic HTTP POST — Pingram / Twilio / Netgsm / etc.) ---
# Generic: POST a JSON body to NOTIFY_SMS_URL with NOTIFY_SMS_AUTH_HEADER as
# the Authorization header. {phone}, {message}, {sender} placeholders are
# substituted into NOTIFY_SMS_BODY_TEMPLATE at dispatch time.
NOTIFY_SMS_ENABLED=false
NOTIFY_SMS_URL=
NOTIFY_SMS_AUTH_HEADER=Bearer YOUR_TOKEN
NOTIFY_SMS_SENDER=nimshop
NOTIFY_SMS_BODY_TEMPLATE={"phone":"{phone}","message":"{message}","sender":"{sender}"}
NOTIFY_SMS_DRY_RUN=false  # true = log only, false = real send
