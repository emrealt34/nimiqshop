[Unit]
Description=nim.shop frontend (static server + /api proxy on :__FRONTEND_PORT__)
Documentation=file://__APP_HOME__/README_SETUP.md
After=network-online.target nimshop-backend.service
Wants=network-online.target nimshop-backend.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_HOME__
ExecStart=__NODE_BIN__ scripts/static-server.mjs
# PORT / BACKEND / FORWARDED_HEADER_SECRET / NIMSHOP_NO_URL_OVERRIDE
# are generated by deploy/install-systemd.sh into deploy/frontend.env.
# FORWARDED_HEADER_SECRET must be the SAME value as in backend/.env.
EnvironmentFile=-__APP_HOME__/deploy/frontend.env
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

# --- Hardening (the frontend only reads dist/ and public/) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
