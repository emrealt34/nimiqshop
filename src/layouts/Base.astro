---
// Base.astro — the shared page shell. Mirrors the original index.html/orders.html
// etc. head exactly (CSP, vendored fonts, theme) and mounts the React shell.
import fraunces900Url from '../assets/fonts/fraunces-900.woff2';
import nunitoVarUrl from '../assets/fonts/nunito-var.woff2';
import '../styles/fonts.css';
import '../styles/app.css';
import '../styles/fixes.css';
import '../styles/accessibility.css';
import type { ShellKey } from '../components/shell/SiteShell';
import BuildGuard from '../components/ui/BuildGuard.tsx';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { flattenBrands } from '../lib/catalog';
import { setShelfSeed, type ShelfSeed } from '../lib/shelfSeed';

interface Props {
  title: string;
  description?: string;
  activeKey: ShellKey;
  /** Per-locale route language ('de'…'tr'); the shell is built in it. */
  lang?: string;
  /** i18n key for the tab title on pages with no React router (e.g. 404).
   *  React routes carry their own titleKey; this one is applied by the static
   *  localiser so the tab follows the language too. */
  titleKey?: string;
  /** Inline the build-time shelf seed (default-country catalog) so the home
   *  grid paints with real cards in the first frame. Home page only. */
  shelfSeed?: boolean;
  /** Extra head tags (JSON-LD, OG, etc.) passed via <Fragment set:html> not needed — use slots. */
}
const { title, description, activeKey, titleKey, shelfSeed = false, lang } = Astro.props;
const siteName = 'shop.nimiqbase.com';
// The route language: prefixed twins (/tr/…) build their shell in it, the
// unprefixed root stays English (its boot script redirects non-English
// visitors to their twin BEFORE paint, so nobody ever watches a flip).
const routeLang = lang && lang !== 'en' ? lang : 'en';
import enShell from '../i18n/locales/en';
import deShell from '../i18n/locales/de';
import frShell from '../i18n/locales/fr';
import esShell from '../i18n/locales/es';
import ptShell from '../i18n/locales/pt';
import trShell from '../i18n/locales/tr';
const SHELL_DICTS: Record<string, any> = { en: enShell, de: deShell, fr: frShell, es: esShell, pt: ptShell, tr: trShell };
/** Build-time translator for the few static-shell strings (skip link, footer
 *  credit, tab title, meta description) so the FIRST paint is translated. */
function shellT(key: string, vars: Record<string, string> = {}): string {
  const walk = (d: any) => key.split('.').reduce((n: any, k: string) => (n == null ? undefined : n[k]), d);
  const node = walk(SHELL_DICTS[routeLang]) ?? walk(enShell);
  let str = typeof node === 'string' ? node : key;
  for (const [k, v] of Object.entries(vars)) str = str.split('{{' + k + '}}').join(v);
  return str;
}
// Build fingerprint for BuildGuard. The deploy builds on the GitHub runner
// (GITHUB_SHA), Cloudflare-native builds export CF_PAGES_COMMIT_SHA; local
// builds get a constant and are never deployed.
const buildId = process.env.GITHUB_SHA || process.env.CF_PAGES_COMMIT_SHA || 'local';

// --- Locale ----------------------------------------------------------------
// This build is STATIC (output: 'static') — there is NO per-request server
// that could read cookies/headers at render time. <html lang> starts as "en"
// and is corrected synchronously by the tiny inline script below BEFORE any
// content paints, using the same priority chain the React i18n uses:
//   ?lang= → cookie → localStorage → navigator.language → "en".
// React then hydrates on top with the identical choice, so there is no flash
// of the wrong language.
const initialLang = routeLang;

// ---- Shelf seed (home page, build time) ----------------------------------
// Reads the committed/hourly catalog snapshot for the default country and
// flattens it exactly like the live path, so SSR cards === client seed cards.
// Missing snapshot (fresh clone before the first sync) simply means no seed.
let seedPayload: ShelfSeed | null = null;
if (shelfSeed) {
  try {
    const raw = readFileSync(join(process.cwd(), 'public', 'data', 'catalog', 'brands', 'TR.json'), 'utf8');
    const j = JSON.parse(raw);
    const CAP = 48; // per kind: enough to fill several screens, small in HTML
    const maps = {
      gift_card: flattenBrands({ categories: (j.categories || []).filter((c: any) => c.kind === 'giftcard' || c.category === 'giftcard') }, 'TR').slice(0, CAP),
      phone_refill: flattenBrands({ categories: (j.categories || []).filter((c: any) => (c.kind === 'mobile_recharge' || c.category === 'mobile_recharge') && c.category !== 'e-sim') }, 'TR').slice(0, CAP),
      esim: flattenBrands({ categories: (j.categories || []).filter((c: any) => c.category === 'e-sim') }, 'TR').slice(0, CAP),
    };
    seedPayload = { country: 'TR', at: String(j.generated_at || new Date().toISOString()), maps };
    setShelfSeed(seedPayload);
  } catch {
    seedPayload = null;
  }
}

// The market the build's shelf seed belongs to; the boot script hides that grid
// for a visitor whose market is known to be different (see the market hold below
// and the CSS block in app.css).
const seedCountry = String((seedPayload && (seedPayload as { country?: string }).country) || 'TR');

// ---- Content Security Policy --------------------------------------------
//
// The CSP used to be one hardcoded string that shipped the development
// policy to production. Two of its allowances exist only so `npm run dev`
// works, and both are real attack surface on a live shop:
//
//   'unsafe-eval'          — lets any injected script compile and run a
//                            string as code. Vite's dev server needs it for
//                            HMR; a production Astro build emits plain ESM
//                            and never calls eval.
//   https://*.trycloudflare.com
//                          — a wildcard over a domain anyone on the internet
//                            can register a tunnel on. In `connect-src` it
//                            means exfiltrated cardholder/checkout data could
//                            be POSTed to an attacker's tunnel and the CSP
//                            would not stop it.
//
// They are now gated on `import.meta.env.DEV`, which Vite replaces with a
// literal at build time — so the dev string is not merely unused in the
// production bundle, it is not present in it at all.
const isDev = import.meta.env.DEV;
// API_URL — ONE build-time knob for "frontend hosted elsewhere (Cloudflare
// Pages, Netlify…) calling this backend": `API_URL=https://api.example.com npm run build`
// bakes three things into every page: the API origin in CSP connect-src, a
// preconnect to it, and a window.APP_CONFIG seed (API_BASE) that wins over
// public/config.js's default. When empty everything keeps using the
// same-origin '/api' proxy.
const buildApiUrl = String(import.meta.env.PUBLIC_API_URL || process.env.API_URL || '').trim().replace(/\/+$/, '').replace(/\/api$/, '');
// Production replaces 'unsafe-inline' with a placeholder that
// integrations/csp-inline-hashes.mjs substitutes after the build with the
// SHA-256 hashes of every inline script tag actually emitted into dist/. The
// (Written without angle brackets on purpose: Vite's dev transform scans this
//  file for script tags textually, and a literal tag inside a comment makes
//  esbuild parse the rest of the comment as JavaScript.)
// string must match CSP_HASH_PLACEHOLDER in that file; if it drifts, the
// integration fails the build rather than shipping a policy that silently
// blocks the theme, viewport and scroll scripts.
//
// Dev keeps 'unsafe-inline' (and 'unsafe-eval') because Vite injects its own
// inline bootstrap and HMR script, whose contents change per request and
// therefore cannot be hashed. `import.meta.env.DEV` is replaced with a literal
// at build time, so the dev string is not present in the production bundle.
//
// https://static.cloudflareinsights.com is the Cloudflare Web Analytics
// beacon that Cloudflare injects into every HTML response of a proxied zone
// with Web Analytics switched on (the shop is served through Cloudflare
// Pages). It reports to /cdn-cgi/rum on this origin, so connect-src needs
// nothing beyond 'self'. Keep in sync with public/_headers.
const cspScriptSrc = isDev
  ? "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://hub.nimiq.com https://static.cloudflareinsights.com"
  : "script-src 'self' __CSP_SCRIPT_HASHES__ https://hub.nimiq.com https://static.cloudflareinsights.com";
const cspConnectExtra = isDev
  ? ' http://localhost:8084 http://127.0.0.1:8084 https://*.trycloudflare.com'
  : '';
// Dictionary preload map — in production builds the token below is replaced,
// after the build, with a JSON object mapping every non-English language to
// the URL of its built dictionary chunk (integrations/dict-preload-map.mjs).
// The pre-paint language bootstrap uses it to attach a <link
// rel="modulepreload"> for the visitor's language BEFORE any bundle runs, so
// the strings are already in the module cache when React hydrates and the
// language flip is effectively immediate instead of a second round trip.
// That integration MUST run before cspInlineHashes() so the CSP hashes the
// final bytes of the script it lands in. Dev builds have no hashed chunks to
// point at; the empty map simply disables the preload there.
const dictPreloadMap = isDev ? '{}' : '__DICT_PRELOAD_MAP__';
// `frame-ancestors` is deliberately NOT in the <meta> policy.
//
// The directive only has meaning when the policy arrives as an HTTP header —
// the HTML spec lets a <meta> CSP express it, but every browser ignores it
// there, and Chrome logs "The Content Security Policy directive
// 'frame-ancestors' is ignored when delivered via a <meta> element" on every
// single page load. That warning trains whoever reads the console to ignore
// CSP messages, which is worse than the noise itself.
//
// The protection is not lost: public/_headers sends
// `frame-ancestors 'none'` (plus `X-Frame-Options: DENY`) as a real header on
// every response, and that is the copy browsers actually enforce. It stays out
// of the meta tag purely because that copy would be a no-op.
const contentSecurityPolicy = [
  "default-src 'self'",
  cspScriptSrc,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self' data:",
  `connect-src 'self' https://shopapi.nimiqbase.com https://*.shop.nimiqbase.com https://hub.nimiq.com https://hub.nimiq-testnet.com${buildApiUrl ? ' ' + buildApiUrl : ''}${cspConnectExtra}`,
  'frame-src https://hub.nimiq.com https://hub.nimiq-testnet.com https://widget.trustpilot.com',
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');

// Only preconnect when an explicit cross-origin deployment is requested.
const apiOrigin = buildApiUrl;
const assetBase = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') || '';
---

<!doctype html>
<html lang={initialLang} data-lang={initialLang} data-title-key={titleKey}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#E7DAC0" />
    <meta name="shop-base" content={assetBase} />
    <meta name="color-scheme" content="light dark" />
    <!--
      Boot-time language bootstrap (synchronous, runs before paint).
      The site is fully static — there is no per-request server to decide the
      language at render time. This tiny script rewrites <html lang>/data-lang
      BEFORE the browser paints any text; React's I18nProvider later reads the
      IDENTICAL chain (keep the two in sync: src/i18n detectLang) and picks the
      same code, so there is zero flash of the wrong language.
      The chain follows the SYSTEM — the device's own setting and, inside
      Nimiq Pay, the host app's language — never a guess from the visitor's IP:
        ?lang= → the visitor's own switcher pick (nimshop.lang.user) →
        window.nimiqPay.language → the saved value (cookie, then
        localStorage.nimshop.lang) → navigator.language → 'en'.
      The host's "en" is Nimiq Pay's fallback for languages it does not ship
      (Turkish is one), so when the device asks for a language we do serve,
      that beats it (see readHost below).
    -->
    <script is:inline define:vars={{ dictPreloadMap }}>
      (function () {
        try {
          var SUPPORTED = { en: 1, es: 1, de: 1, fr: 1, pt: 1, tr: 1 };
          function clean(raw) {
            if (!raw) return null;
            var c = String(raw).trim().toLowerCase().slice(0, 2);
            return SUPPORTED[c] ? c : null;
          }
          function readQuery() {
            try {
              var u = new URLSearchParams(location.search);
              return clean(u.get('lang'));
            } catch (e) { return null; }
          }
          function readCookie() {
            try {
              var m = document.cookie.match(/(?:^|;\s*)nimshop-lang=([^;]+)/);
              return m ? clean(decodeURIComponent(m[1])) : null;
            } catch (e) { return null; }
          }
          function readStorage() {
            try { return clean(localStorage.getItem('nimshop.lang')); }
            catch (e) { return null; }
          }
          function readNav() {
            try {
              var list = (navigator.languages && navigator.languages.length)
                ? navigator.languages : [navigator.language];
              for (var i = 0; i < list.length; i++) {
                var c = clean(list[i]);
                if (c) return c;
              }
            } catch (e) {}
            return null;
          }
          // The visitor's explicit switcher pick lives in its own slot, so an
          // auto-detected value cannot outrank it (src/i18n writes the same
          // key — keep the two in sync).
          function readUserPick() {
            try { return clean(localStorage.getItem('nimshop.lang.user')); }
            catch (e) { return null; }
          }
          // Inside Nimiq Pay the host injects the user's app language before
          // any script runs (docs: nimiq.dev/mini-apps/features/localization).
          // It is the user's own choice for that app, so it outranks the
          // device locale — except when the host fell back to its own default
          // "en" for a language Nimiq Pay does not ship (Turkish is one) while
          // the device asks for one we DO ship.
          function readHost() {
            try {
              var p = window.nimiqPay;
              return p && p.language ? clean(p.language) : null;
            } catch (e) { return null; }
          }
          var queryLang = readQuery();
          var userPick = readUserPick();
          var hostLang = readHost();
          var devLang = readNav();
          var hostWins = hostLang && !(hostLang === 'en' && devLang && devLang !== 'en');
          // Same order as detectLang() in src/i18n — ?lang → own pick → host →
          // saved → device → English. No IP is consulted at any point.
          var lang = queryLang || userPick || (hostWins ? hostLang : null)
                  || readCookie() || readStorage() || devLang || 'en';
          // ---- per-locale static routes ------------------------------------
          // /de/… /tr/… are built in their own language, so their first paint
          // is already translated and needs no hold and no flip. The
          // unprefixed root is the auto entry: when the resolved language is
          // not English, replace() to the prefixed twin BEFORE paint (this
          // script runs in <head>, the body has not parsed yet — the visitor
          // perceives a single, already-translated load). On a prefixed page
          // only an explicit pick (?lang= or the switcher's saved choice) may
          // move the visitor; a shared /de/ link must stay German otherwise.
          var BASE = '';
          try {
            var mb = document.querySelector('meta[name="shop-base"]');
            if (mb) BASE = mb.getAttribute('content') || '';
          } catch (eB) {}
          var rawPath = location.pathname;
          if (BASE && rawPath.indexOf(BASE) === 0) rawPath = rawPath.slice(BASE.length) || '/';
          var firstSeg = rawPath.split('/')[1] || '';
          var isPrefixed = firstSeg === 'de' || firstSeg === 'fr' || firstSeg === 'es' || firstSeg === 'pt' || firstSeg === 'tr';
          var restPath = isPrefixed ? (rawPath.slice(('/' + firstSeg).length) || '/') : rawPath;
          if (!isPrefixed) {
            if (lang !== 'en') {
              location.replace(BASE + '/' + lang + restPath + location.search + location.hash);
              return;
            }
          } else {
            var pick = queryLang || userPick;
            if (pick && pick !== firstSeg) {
              location.replace(BASE + (pick === 'en' ? '' : '/' + pick) + restPath + location.search + location.hash);
              return;
            }
            lang = firstSeg;
          }
          document.documentElement.setAttribute('lang', lang);
          document.documentElement.setAttribute('data-lang', lang);
          // HOLD — last resort, and only on a FIRST visit in this language.
          // The page is server-rendered in English (a static build has no
          // visitor to render for), so without this the visitor would watch the
          // whole page flip from English to the real language the moment React
          // hydrated and the dictionary chunk landed. While held, the body is
          // simply unpainted (background colour, no artwork): the CSS-only
          // loader that used to pulse here was removed at the owner's request
          // once the dictionary cache made this path rare. Safety nets: a hard
          // timeout below, and the hold is skipped entirely for English and for
          // any language whose dictionary is already cached.
          // A returning visitor already has the dictionary in localStorage
          // (written by src/i18n after the first load), so there is nothing to
          // hide: no hold, no loader, the first paint is translated. The key
          // and its meaning are documented in src/i18n/index.tsx.
          // Warm the dictionary chunk for this language while the HTML is
          // still parsing. Non-English dictionaries are lazy chunks that
          // React only imports after hydration; without this the visitor's
          // language lands one round trip late and the page visibly flips
          // from English. `dictPreloadMap` is injected by define:vars:
          // production builds emit the placeholder string, which
          // integrations/dict-preload-map.mjs replaces (quotes included)
          // with the real {lang: url} object literal after the build; dev
          // builds ship the string '{}'. The typeof check accepts both
          // shapes, and the nested try means a stale/absent map can never
          // break the language attributes above.
          try {
            var DICT = typeof dictPreloadMap === 'string' ? JSON.parse(dictPreloadMap) : (dictPreloadMap || {});
            var dictHref = DICT && DICT[lang];
            if (dictHref && document.head) {
              var pre = document.createElement('link');
              pre.rel = 'modulepreload';
              pre.href = dictHref;
              document.head.appendChild(pre);
            }
          } catch (e2) {}
        } catch (e) {
          // If anything throws (private mode, etc.) leave the build default.
        }
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          var k = 'nimshop.theme';
          var t = localStorage.getItem(k);
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
          document.documentElement.style.colorScheme = t;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'dark' ? '#1a1c20' : '#E7DAC0');
          var cs = document.querySelector('meta[name="color-scheme"]');
          if (cs) cs.setAttribute('content', t);
        } catch (e) {}
      })();
    </script>
    {/* Start the saved-country catalog + market snapshots during HTML parse,
        so they are already in the HTTP cache when React asks for them after
        hydration; preconnect warms the logo CDN TLS handshake for the grid.
        The market is the visitor's SAVED country when there is one, else their
        own locale — the region ("tr-TR" → TR) and then the country the host /
        device language usually means. Never an IP guess: the request reaches
        the backend through the Cloudflare tunnel, so a geo lookup would resolve
        the tunnel egress (or a VPN), not the buyer. Self-contained on purpose:
        an is:inline script has its own scope, so it re-reads what it needs. */}
    <script is:inline define:vars={{ assetBase, seedCountry }}>
      (function () {
        try {
          var two = /^[a-z]{2}$/;
          var host = (function () {
            try {
              var p = window.nimiqPay;
              var c = p && p.language ? String(p.language).trim().toLowerCase().slice(0, 2) : '';
              return two.test(c) ? c : '';
            } catch (e) { return ''; }
          })();
          var dev = (function () {
            try {
              var list = (navigator.languages && navigator.languages.length)
                ? navigator.languages : [navigator.language];
              for (var i = 0; i < list.length; i++) {
                var c = String(list[i] || '').trim().toLowerCase().slice(0, 2);
                if (two.test(c)) return c;
              }
            } catch (e) {}
            return '';
          })();
          var cc = (localStorage.getItem('nimshop_country') || '').trim().toUpperCase().slice(0, 2);
          if (!/^[A-Z]{2}$/.test(cc)) {
            var tags = (navigator.languages && navigator.languages.length)
              ? navigator.languages : [navigator.language];
            for (var ti = 0; ti < tags.length && !/^[A-Z]{2}$/.test(cc); ti++) {
              var m2 = /^[a-z]{2,3}[-_]([a-z]{2})$/i.exec(String(tags[ti] || '').trim());
              if (m2) cc = m2[1].toUpperCase();
            }
          }
          if (!/^[A-Z]{2}$/.test(cc)) {
            var byLang = { tr: 'TR', de: 'DE', fr: 'FR', es: 'ES', pt: 'PT' };
            cc = byLang[host || dev] || '';
          }
          var base = typeof assetBase === 'string' ? assetBase : '';
          var files = [
            base + '/data/catalog/brands/' + (cc || seedCountry || 'TR') + '.json',
            base + '/data/market/fx.json',
            base + '/data/market/nim-rate.json',
          ];
          for (var i = 0; i < files.length; i += 1) {
            var l = document.createElement('link');
            l.rel = 'preload'; l.as = 'fetch'; l.href = files[i];
            document.head.appendChild(l);
          }
          var pc = document.createElement('link');
          pc.rel = 'preconnect'; pc.href = 'https://cdn.cryptorefills.com';
          document.head.appendChild(pc);

          // MARKET HOLD — the server-rendered grid is the build's own market
          // (the shelf seed). A visitor whose market we already know to be
          // different must not see those brands for a beat: measured, a US
          // visitor saw "Amazon.com.tr" from 74 ms to 734 ms and THEN the US
          // shelf. The stylesheet hides the seeded cards (the grid keeps its
          // height, min-height:62vh) and pulses the shop's hexagon instead;
          // HomePage removes the attribute in the same commit that puts the
          // visitor's own catalog on screen. Same pattern and same 5 s safety
          // timeout as the language hold above — a JS-less visitor never gets
          // the attribute at all.
          var sc = typeof seedCountry === 'string' ? seedCountry : '';
          if (cc && sc && cc !== sc) {
            var r = document.documentElement;
            r.setAttribute('data-market-hold', '');
            setTimeout(function () { r.removeAttribute('data-market-hold'); }, 5000);
          }
        } catch (e) {}
      })();
    </script>
    <meta
      name="description"
      content={description || (routeLang !== 'en' ? shellT('meta.defaultDescription') : "Buy gift cards, mobile top-ups and eSIMs with NIM via BTC Lightning in Nimiq Pay. No internal balance, direct CryptoRefills payment, and open source.")}
      data-i18n-attr={description ? undefined : 'content:meta.defaultDescription'}
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{titleKey && routeLang !== 'en' ? shellT(titleKey) : title}</title>
    <link rel="icon" type="image/png" sizes="64x64" href={`${assetBase}/img/icon-64.png?v=nim-favicon-2`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${assetBase}/img/icon-512.png?v=nim-favicon-2`} />
    <link rel="apple-touch-icon" href={`${assetBase}/img/apple-touch-icon.png?v=nim-favicon-2`} />
    <link rel="dns-prefetch" href="https://cdn.cryptorefills.com" />
    {apiOrigin && <link rel="preconnect" href={apiOrigin} crossorigin />}
    {apiOrigin && <link rel="dns-prefetch" href={apiOrigin} />}
    {/* Preload both webfont files. Both faces are font-display:optional, whose
        ~100 ms window starts at first layout — the preload is what gives the
        real fonts a chance to win it (and guarantees the file is cached for
        the next visit, where it wins outright). Miss the window and the
        metric-matched fallbacks render the whole pageview: no layout shift,
        and no typeface change after paint, ever. */}
    <link rel="preload" as="font" type="font/woff2" href={fraunces900Url} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={nunitoVarUrl} crossorigin />
    {buildApiUrl && (
      <script is:inline define:vars={{ buildApiUrl }}>
        window.APP_CONFIG = Object.assign(window.APP_CONFIG || {}, {
          API_BASE: buildApiUrl + '/api',
          FRONTEND_URL: '',
          // SITE_HOST is the shop's brand, NOT the API host — leave it to
          // config.js (default shop.nimiqbase.com). Seeding it from API_URL made
          // the header wordmark read "shopapi.nimiqbase.com".
        });
      </script>
    )}
    <script is:inline src={`${assetBase}/config.js`} defer fetchpriority="low"></script>
    {/* Wallet SDK is NOT loaded here. src/lib/vendorLoad.ts injects it with
        ensureLib('HubApi') and already warms it on idle; the eager deferred tag
        that used to sit at this spot was a second copy of the same 11 KB on
        every page, including the ones that never open a wallet. The loader is
        the single source of truth, so a page cannot drift from it. */}
    <script is:inline>
      // NOTE: there used to be a `pre-hydration` class here. It let the
      // stylesheet hide the footer while the page was still an empty
      // client:only island — the shell painted an empty content area, and the
      // footer was pushed down the moment React rendered it (measured 0.05-0.07
      // CLS). Every island is server-rendered now (client:load), so the footer
      // sits at its final position from the first frame and the workaround is
      // gone: hiding then revealing an element is itself scored as a shift.
    </script>
    <script is:inline>
      (function () {
        if (typeof window !== 'undefined' && window.nimiqPay) {
          document.documentElement.classList.add('in-nimiq-pay');
          var m = document.querySelector('meta[name="viewport"]');
          if (m) m.setAttribute('content', 'width=device-width, initial-scale=1, viewport-fit=cover');
        }
      })();
    </script>
    {seedPayload && (
      <script
        is:inline
        set:html={`window.__SHELF_SEED=${JSON.stringify(seedPayload).replace(/</g, '\\u003c')};`}
      />
    )}
    <meta name="build-id" content={buildId} />
  </head>
  <body>
    <a class="skip-link" href="#page-content" data-i18n="stat.skipToContent">{shellT('stat.skipToContent')}</a>
    <noscript>
      <div style="padding:40px;text-align:center;font-family:sans-serif;color:var(--ink, #4E3D28)">
        <span data-i18n="stat.needsJs">{shellT('stat.needsJs', { site: siteName })}</span>
      </div>
    </noscript>

    <main id="main" class="page">
      <slot />
    </main>

    <BuildGuard client:load />

    <footer class="footer">
      <div class="container">
        <span data-fit="wrap" data-fit-min="10">© <span>NimiqBase</span><span class="footer-credit"> <span data-i18n="stat.poweredCredit">{shellT('stat.poweredCredit')}</span></span></span>
        <div class="footer-barcode">
          <!-- Inline (not <img>) so the bars can use currentColor: kraft brown
               in light, footer-ink in dark — a brown barcode vanishes on the
               dark surface. Geometry is byte-identical to barcode-nimiq.svg. -->
          <svg viewBox="0 0 180 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path stroke="currentColor" stroke-width="4" d="M2 24L2 0M24 24L24 0M56 24L56 0M100 24L100 0M134 24L134 0M156 24L156 0M178 24L178 0" />
            <path stroke="currentColor" stroke-width="2" d="M7 24L7 0M13 24L13 0M35 24L35 0M39 24L39 0M45 24L45 0M61 24L61 0M85 24L85 0M89 24L89 0M105 24L105 0M111 24L111 0M117 24L117 0M141 24L141 0M173 24L173 0" />
            <path stroke="currentColor" stroke-width="8" d="M70 24L70 0M124 24L124 0" />
            <path stroke="currentColor" stroke-width="6" d="M79 24L79 0M149 24L149 0M167 24L167 0" />
          </svg>
        </div>
        <span class="row">
          <a
            class="bb-gh"
            href="https://github.com/emrealt34/nimiqshop"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={shellT('stat.githubLabel')}
            title={shellT('stat.githubLabel')}
            data-i18n-attr="aria-label:stat.githubLabel title:stat.githubLabel"
          >
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <g transform="translate(1.05 0)">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>
              </g>
            </svg>
          </a>
        </span>
      </div>
    </footer>
    <script is:inline>
      // Keep scroll position stable when resizing / zooming — if you are at the bottom, stay at the bottom.
      //
      // GEOMETRY COMES FROM A RESIZEOBSERVER. Its callback runs after the
      // browser has laid the document out for the frame, so reading
      // scrollHeight there is free. The old version read scrollHeight from
      // the scroll/resize handlers and a double-rAF, i.e. right after
      // something had invalidated layout (the deferred stylesheet flip, a
      // fitText pass) — a synchronous forced reflow on every hit, which is
      // what PageSpeed's forced-reflow insight attributed ~30 ms to.
      (function () {
        var lastY = 0;
        var lastH = 0;
        var lastVH = 0;
        var pending = false;   // a resize asked for a post-layout correction
        var prevH = 0;
        var prevY = 0;
        var wasAtBottom = false;
        function readY() {
          try { lastY = window.scrollY || document.documentElement.scrollTop || 0; } catch (e) {}
        }
        function refresh() {
          try {
            lastH = document.documentElement.scrollHeight || 0;
            lastVH = window.innerHeight || 0;
          } catch (e) {}
        }
        function correct() {
          try {
            var newH = lastH;
            var newVH = lastVH;
            if (wasAtBottom) {
              var target = Math.max(0, newH - newVH);
              if (Math.abs(window.scrollY - target) > 2) window.scrollTo(0, target);
            } else if (prevH > 0) {
              // preserve relative position for large layout shifts (e.g. breakpoint
              // changes): keep the distance from top, clamped to the new max scroll
              var maxY = Math.max(0, newH - newVH);
              if (prevY > maxY) window.scrollTo(0, maxY);
            }
          } catch (e) {}
        }
        var ro = null;
        if (typeof ResizeObserver === 'function') {
          ro = new ResizeObserver(function () {
            refresh();
            if (pending) { pending = false; correct(); }
          });
          ro.observe(document.documentElement);
        }
        // capture on scroll (passive) — scrollY never forces layout
        window.addEventListener('scroll', readY, { passive: true });
        // initial capture: one unavoidable read, mid-parse, before anything
        // else on the page has invalidated layout
        readY();
        refresh();
        function onResize() {
          readY();
          // "Stay at the bottom" only applies to someone who had actually
          // scrolled there. Both guards matter on a phone: the first resize
          // event lands ~200 ms in, while the island is still filling the page
          // in — at that moment the document is shorter than one screen, so
          // lastY is 0 and the page looks like it is "at the bottom" even
          // though nobody moved. Un-guarded, the handler then scrolled a fresh
          // visitor to the bottom of the grown page: the hero never painted in
          // view (Lighthouse reported NO_LCP for the mobile home page) and the
          // page opened mid-content. A page that fits entirely on screen has no
          // bottom to stick to either.
          wasAtBottom = lastY > 0 && lastH > lastVH + 160 && lastH - (lastY + lastVH) < 160;
          prevH = lastH;
          prevY = lastY;
          if (ro) {
            pending = true; // corrected in the observer, after the new layout
          } else {
            setTimeout(function () { refresh(); correct(); }, 60);
          }
        }
        window.addEventListener('resize', onResize, { passive: true });
        if (window.visualViewport) {
          window.visualViewport.addEventListener('resize', onResize, { passive: true });
        }
        // also handle orientationchange
        window.addEventListener('orientationchange', function () { setTimeout(onResize, 150); }, { passive: true });
      })();
    </script>
  </body>
</html>
