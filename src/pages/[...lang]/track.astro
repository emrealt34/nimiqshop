---
import BaseLayout from '../../layouts/Base.astro';
import { TrackPage } from '../../components/track/TrackPage';

import { localeStaticPaths } from '../../lib/localeRoutes';

export function getStaticPaths() { return localeStaticPaths(); }
const routeLang = Astro.params.lang || 'en';
---
<BaseLayout lang={routeLang} title="Track order — shop.nimiqbase.com" titleKey="pageTitle.track" activeKey="track">
  <TrackPage client:load initial={routeLang} />
</BaseLayout>
