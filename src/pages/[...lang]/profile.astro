---
import BaseLayout from '../../layouts/Base.astro';
import { ProfilePage } from '../../components/profile/ProfilePage';

import { localeStaticPaths } from '../../lib/localeRoutes';

export function getStaticPaths() { return localeStaticPaths(); }
const routeLang = Astro.params.lang || 'en';
---
<BaseLayout lang={routeLang} title="Your account — shop.nimiqbase.com" titleKey="pageTitle.profile" activeKey="profile">
  <ProfilePage client:load initial={routeLang} />
</BaseLayout>
