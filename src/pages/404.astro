---
import BaseLayout from '../layouts/Base.astro';
import { asset, pagePath } from '../lib/asset';
---
<BaseLayout title="Page not found — shop.nimiqbase.com" titleKey="pageTitle.notFound" activeKey="none">
  <!-- Static copy of the React TopBar (same classes → same look), so the 404
       page keeps the site navbar. -->
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href={pagePath("/")} aria-label="nim.shop home">
        <img src={asset("/img/brand-icon-50.webp?v=nim-brand-1")} srcset={`${asset("/img/brand-icon-50.webp?v=nim-brand-1")} 50w, ${asset("/img/brand-icon-80.webp?v=nim-brand-1")} 80w, ${asset("/img/brand-icon.png?v=nim-brand-1")} 128w`} sizes="50px" alt="" width="50" height="50" decoding="async" fetchpriority="low" aria-hidden="true" style="display: block; border-radius: 6px;" />
        <span id="site-wordmark">nim<span class="dot">.</span>shop</span>
      </a>
      <nav class="mainnav">
        <a href={pagePath("/")} data-i18n="nav.shop">Shop</a>
        <a href={pagePath("/activity")} data-i18n="nav.activity">Activity</a>
        <a href={pagePath("/orders")} data-i18n="nav.orders">Orders</a>
        <a href={pagePath("/cashback")} data-i18n="nav.cashback">Cashback</a>
        <a href={pagePath("/support")} data-i18n="nav.support">Support</a>
      </nav>
      <div class="topbar-spacer"></div>
      <a class="btn btn-ghost" style="min-height: 40px; padding: 8px 14px;" href={pagePath("/")} data-i18n="ui.connectWallet">Connect wallet</a>
    </div>
  </header>

  <div id="page-content" tabindex="-1" class="container" style="padding-top: 44px; padding-bottom: 64px; text-align: center;">
    <div style="font-size: 3rem; font-weight: 800; letter-spacing: -0.02em;">404</div>
    <div class="strong mt-1" data-i18n="stat.notFoundTitle">This page doesn’t exist.</div>
    <div class="small muted mt-1" data-i18n="stat.notFoundText">The link may be old, or the address was mistyped. Nothing was lost.</div>
    <div style="display: flex; gap: 8px; justify-content: center; margin-top: 18px; flex-wrap: wrap;">
      <a class="btn btn-gold" href={pagePath("/")} data-i18n="stat.backToShop">Back to the shop</a>
      <a class="btn btn-ghost" href={pagePath("/support")} data-i18n="stat.getHelp">Get help</a>
    </div>
  </div>
  <script>
    import { initStaticI18n } from '../lib/staticI18n';
    import { initFit } from '../lib/fitText';
    initStaticI18n();
    initFit();
    document.documentElement.setAttribute('data-app-ready', '1');
  </script>
</BaseLayout>
