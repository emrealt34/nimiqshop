# Hardened response headers for static hosts that support a _headers file
# (Netlify / Cloudflare Pages format). For nginx, mirror these in the server
# block (see frontend/README.md). For hosts with no header support, the <meta>
# CSP in each HTML page already enforces the same policy in the browser.
#
# PRODUCTION SEPARATE DOMAINS:
# If your API is on a different origin (e.g. https://shopapi.nimiqbase.com), add it to connect-src
# and set backend ALLOWED_ORIGINS to your frontend origin.
# Example:
#   Frontend: https://shop.nimiqbase.com
#   Backend:  https://shopapi.nimiqbase.com
#   Frontend config.js: API_BASE='https://shopapi.nimiqbase.com/api'
#   Backend .env: ALLOWED_ORIGINS=https://shop.nimiqbase.com,https://www.shop.nimiqbase.com
#   Then update connect-src below to include https://shopapi.nimiqbase.com and remove localhost if you want.
#
# SAME-ORIGIN (nginx):
#   Keep API_BASE='/api' and ALLOWED_ORIGINS empty — no CORS needed.
#   nginx proxies /api/* to backend, so connect-src 'self' is enough.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Only features browsers still recognise. The retired Privacy Sandbox
  # tokens (attribution-reporting, private-aggregation, join-ad-interest-group,
  # run-ad-auction, browsing-topics) must NOT be listed: Chrome logs
  # "Unrecognized feature" for every one of them on every page load.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  # script-src: 'self' + build-time hashes of the inline scripts + the Nimiq
  # Hub API + Cloudflare Web Analytics. Cloudflare injects
  # https://static.cloudflareinsights.com/beacon.min.js/<version> into every
  # HTML response of a proxied zone with Web Analytics enabled; the beacon
  # posts to /cdn-cgi/rum on THIS origin, so connect-src 'self' already covers
  # it (only a manually embedded snippet would need cloudflareinsights.com).
  # Keep this line in sync with the <meta> policy in src/layouts/Base.astro.
  Content-Security-Policy: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ https://hub.nimiq.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://shopapi.nimiqbase.com https://*.shop.nimiqbase.com https://hub.nimiq.com https://hub.nimiq-testnet.com; frame-src https://hub.nimiq.com https://hub.nimiq-testnet.com https://widget.trustpilot.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/config.js
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/*.html
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

# ---- Asset caching -------------------------------------------------------
#
# WHY THIS SECTION WAS REWRITTEN
#
# The rules below used to target /js/* and /css/* and told them not to cache.
# Those paths do not exist in this project: astro.config.mjs sets
# `build.assets: '_assets'`, so every bundled script and stylesheet is emitted
# as /_assets/<Name>.<hash>.js. The net effect was that ~936 KB of bundles —
# the React runtime, the app shell and every route chunk — matched no cache
# rule at all and fell back to the host default, which revalidates on every
# single navigation. A returning visitor re-requested the whole bundle set to
# be told "not modified", on every page, forever.
#
# The fix is safe precisely BECAUSE of the hashes: /_assets/AppRoot.RnkFeXZI.js
# is a different URL the moment one byte of it changes, so "immutable, one
# year" can never serve stale code. HTML stays no-store so the page always
# points at the current hashes.

#
# NO CDN-Cache-Control HERE — ON PURPOSE.
#
# Cloudflare Pages applies a _headers rule to every response for the path,
# including the 404 it returns while a fresh deployment is still propagating
# (or when a request arrives for a hash the current deployment does not
# have). With a CDN-Cache-Control line the edge stored that 404 for a year
# and the browser for four hours, so a single early request pinned
# "/_assets/client.<hash>.js → 404" at that PoP and the site stayed broken
# with "Failed to fetch dynamically imported module" until a manual purge.
# With Cache-Control alone, Pages keeps its default `no-store` on 404s (the
# 200s are still cached at the edge and for a year in the browser).
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# /img/* is versioned BY CONVENTION: every reference that may ever change
# carries a ?v= tag (icons: ?v=nim-favicon-2 / ?v=nim-brand-1, flags:
# ?v=nim-flags-1, hexagon: ?v=40), and a query string is a new cache key, so
# the origin file itself can be cached immutable for a year. PageSpeed was
# flagging the old 7-day TTL on every repeat visit; swapping artwork now means
# bumping the constant next to the reference (one grep away) instead of
# waiting out a TTL.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# The offline fallback catalog is a build artifact refreshed on deploy; a day
# is long enough to matter and short enough to self-correct.
/fallback-catalog/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# Legacy paths, kept so a deployment that still emits them does not regress
# into "cache a bundle that is not hashed". Harmless no-ops on this build.
/js/*
  Cache-Control: no-store, no-cache, must-revalidate
/css/*
  Cache-Control: no-store, no-cache, must-revalidate
